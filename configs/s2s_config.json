{
    "s2s_engines": [
      {
        "name": "RVC",
        "label": "RVC Settings",
        "upload_params": {
                "AI Models": [
                    {
                        "label": "Model Name",
                        "type": "text",
                        "attribute": "upload_rvc_model_name"
                    },
                    {
                        "label": "Browse RVC .pth model",
                        "type": "file",
                        "attribute": "upload_rvc_model_path",
                        "file_filter": "Model Files (*.pth *.pt);;All Files (*)",
                        "save_path": "engines/rvc",
                        "save_format": "folder"
                    },
                    {
                        "label": "Browse RVC .index file",
                        "type": "file",
                        "attribute": "upload_rvc_index_path",
                        "file_filter": "Index Files (*.index);;All Files (*)",
                        "save_path": "engines/rvc",
                        "save_format": "folder"
                    }
                ],
                "Voice Reference File": [
                ]
            },
        "parameters": [
          {
            "label": "Voice Model",
            "attribute": "selected_voice",
            "type": "combobox",
            "function": "get_combobox_items",
            "folder_path": "engines/rvc",
            "look_for": "folders",
            "file_filter": "*",
            "include_none_option": false,
            "none_option_label": "Default"
          },
          {
            "label": "Sound",
            "attribute": "rvc_preset",
            "type": "preset",
            "options": {
              "Natural narration (recommended)": {"f0method": "rmvpe", "index_rate": 50, "protect": 33, "filter_radius": 3, "rms_mix_rate": 25, "resample_sr": "0:None"},
              "Closer to target voice": {"f0method": "rmvpe", "index_rate": 75, "protect": 40, "filter_radius": 3, "rms_mix_rate": 25, "resample_sr": "0:None"},
              "Fewer artifacts": {"f0method": "rmvpe", "index_rate": 30, "protect": 25, "filter_radius": 5, "rms_mix_rate": 50, "resample_sr": "0:None"},
              "Custom": {}
            }
          },
          {
            "label": "Voice Pitch (semitones)",
            "attribute": "f0pitch",
            "type": "slider",
            "min": -16,
            "max": 16,
            "default": 0
          },
          {
            "label": "Pitch Method",
            "attribute": "f0method",
            "advanced": true,
            "type": "combobox",
            "function": "get_combobox_items",
            "look_for": "custom",
            "custom_options": ["rmvpe", "harvest", "crepe"]
          },
          {
            "label": "Index Effect (likeness to the trained voice)",
            "attribute": "index_rate",
            "advanced": true,
            "type": "slider",
            "min": 0,
            "max": 100,
            "default": 50,
            "step":100
          },
          {
            "label": "Resample Sample Rate (Hz)",
            "attribute": "resample_sr",
            "advanced": true,
            "type": "combobox",
            "function": "get_combobox_items",
            "look_for": "custom",
            "custom_options": ["0:None", "40000:v1 Models", "48000:v2 Models"]
          },
          {
            "label": "Volume Envelope (0 = follow the TTS loudness)",
            "attribute": "rms_mix_rate",
            "advanced": true,
            "type": "slider",
            "min": 0,
            "max": 100,
            "default": 25,
            "step": 100
          },
          {
            "label": "Protection for Voiceless Consonants",
            "attribute": "protect",
            "advanced": true,
            "type": "slider",
            "min": 0,
            "max": 50,
            "default": 33,
            "step": 100
          },
          {
            "label": "Filter Radius",
            "attribute": "filter_radius",
            "advanced": true,
            "type": "slider",
            "min": 0,
            "max": 7,
            "default": 3
          }
        ]
      }
    ]
  }
  